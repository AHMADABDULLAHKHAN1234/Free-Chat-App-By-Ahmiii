# Copy this file to .env.local for local development.
# Keep real API keys secret. Never commit .env.local or use NEXT_PUBLIC_ for keys.

# Required for Gemini chat, image generation, and stickers.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Optional model overrides; fallback lists are comma-separated.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image
